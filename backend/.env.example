# Environment variables required for the backend
DATABASE_URL="postgresql://user:password@localhost:5432/svdts_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Frontend origin URL for CORS (no trailing slash, e.g. "http://localhost:3000" or "https://stocklearn.com")
FRONTEND_URL="http://localhost:3000"

# COOKIE_SAME_SITE: defaults to "strict" for local dev so that the browser can accept the cookie 
# over plain http://localhost without requiring Secure=true. 
# For production (e.g. frontend on Vercel, backend on Railway), set this to "none"
# which will automatically enforce Secure=true to allow cross-site cookies.
COOKIE_SAME_SITE="strict"
